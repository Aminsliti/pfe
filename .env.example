# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maintest
DB_USER=postgres
DB_PASSWORD=vitalis

# Server Configuration
PORT=3001
GRC_API_BASE_URL=http://localhost:5001/api

# Security
# Use a long random value in real deployments. Production startup requires at least 32 characters.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=30d

# Email (SMTP) Configuration (optional)
# If you don't set these, the backend will NOT send emails and will instead log the generated email payload.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username-or-email
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="V-BPM <no-reply@example.com>"
